      "parameters": {
        "jsCode": "const pages = $('выбрать сделки').all(); // ВСЕ ответы HTTP-узла за этот запуск\nconst leads = [];\nfor (const p of pages) {\n  if (p.json._embedded?.leads) leads.push(...p.json._embedded.leads);\n}\n\nconst FINAL_ENUMS = ['659828', '659834']; // Вручено, Возвращено\nconst getVal = (cf, fid) => cf?.find(f => f.field_id === fid)?.values?.[0]?.value;\n\nconst active = leads\n  .map(l => ({\n    lead_id: l.id,\n    name: l.name,\n    track: getVal(l.custom_fields_values, 396813),\n    postal_status: getVal(l.custom_fields_values, 1029790),\n    responsible_user_id: l.responsible_user_id\n  }))\n  .filter(x => x.track && !FINAL_ENUMS.includes(String(x.postal_status)));\n\nreturn active.map(x => ({ json: x }));;"
      },
