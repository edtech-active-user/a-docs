      "name": "Get public link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3024,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Find client folder').first().json;\nconst publicUrl = String($json.public_url || '');\nif (!publicUrl) throw new Error('Yandex Disk did not return public_url after publishing the DOCX.');\nreturn [{ json: {\n  success: true,\n  docx_url: publicUrl,\n  public_url: publicUrl,\n  disk_path: $json.path || source.targetPath,\n  file_name: $json.name || source.fileName,\n  folder_path: source.folderPath,\n  folder_name: source.folderName\n} }];"
      },
