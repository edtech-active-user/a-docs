      "id": "f49ef5f5-86d8-4ce1-b8ac-d91006961494",
      "name": "List client folders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1648,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Prepare upload').first();\nconst items = $input.all().flatMap(item => item.json._embedded?.items || []);\nconst markers = [`(${source.json.dealId})`];\nif (source.json.contractNumber && source.json.contractNumber !== source.json.dealId) {\n  markers.push(`(${source.json.contractNumber})`);\n}\nconst folders = items.filter(item =>\n  item.type === 'dir' && markers.some(marker => String(item.name || '').includes(marker))\n);\nif (!folders.length) {\n  throw new Error(`Client folder not found in ${source.json.parentPath}: ${markers.join(' or ')}`);\n}\nif (folders.length > 1) {\n  throw new Error(`More than one client folder found: ${folders.map(item => item.name).join(', ')}`);\n}\nconst folder = folders[0];\nreturn [{\n  json: {\n    folderPath: folder.path,\n    folderName: folder.name,\n    fileName: source.json.fileName,\n    targetPath: `${folder.path}/${source.json.fileName}`\n  },\n  binary: source.binary\n}];"
      },
      "id": "09b83027-0c85-4822-961d-07cff6b9abf4",
      "name": "Find client folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        112
      ]
    },
    {
      "parameters": {
        "url": "https://cloud-api.yandex.net/v1/disk/resources/upload",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "path",
              "value": "={{ $json.targetPath }}"
            },
            {
              "name": "overwrite",
              "value": "true"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'OAuth ' + $env.YANDEX_DISK_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7ac66a45-b8c2-4cb6-bdc5-e6b0ea8fe62f",
      "name": "Get upload URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2096,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Find client folder').first();\nif (!$json.href) throw new Error('Yandex Disk did not return an upload URL.');\nreturn [{ json: {\n  href: $json.href,\n  targetPath: source.json.targetPath,\n  folderPath: source.json.folderPath,\n  folderName: source.json.folderName,\n  fileName: source.json.fileName\n}, binary: source.binary }];"
      },
      "id": "f58563eb-5ff6-4d54-8eb1-4ce685282272",
      "name": "Restore DOCX binary",
