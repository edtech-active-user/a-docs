      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\n\nconst TYPES = { \"Бандероль\": \"BANDEROL\", \"Посылка\": \"POSTAL_PARCEL\" };\nconst CATS  = { \"Заказное\": \"ORDERED\", \"Простое\": \"SIMPLE\",\n                \"С объявленной ценностью\": \"DECLARED\" };\nconst PAY   = { \"Знак онлайн оплаты\": \"ONLINE_PAYMENT_MARK\",\n                \"Безналичный расчет\": \"CASHLESS\" };\n\nconst addr = d.address || \"\";\nif (!addr) throw new Error(\"Нет поля address. Пришло: \" + JSON.stringify(d));\n\nconst index = (addr.match(/\\d{6}/) || [\"\"])[0];\nif (!index) throw new Error(\"В адресе нет индекса (6 цифр): \" + addr);\n\nconst body = { orders: [{\n  \"order-num\": String(d.lead_id),\n  \"recipient-name\": d.recipient_name,\n  \"index-to\": Number(index),\n  \"raw-address\": addr,\n  \"mail-direct\": 643,\n  \"mail-type\": TYPES[d.mail_type] || \"BANDEROL\",\n  \"mail-category\": CATS[d.mail_category] || \"ORDERED\",\n  \"mass\": Number(d.mass),\n  \"payment-method\": PAY[d.payment] || \"CASHLESS\"\n}]};\n\nreturn [{ json: body }];"
      },
