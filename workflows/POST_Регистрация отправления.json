      "id": "e439abdf-fa51-4a9d-b487-437c983fcbd2",
      "name": "Webhook",
      "webhookId": "cfbd99dc-44df-4aed-8801-4921905d556f"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.body || {};\n\nconst TYPES = {\n  \"Бандероль\": \"BANDEROL\",\n  \"Письмо\": \"LETTER\",\n  \"Бандероль 1 класса\": \"BANDEROL_CLASS_1\",\n  \"Письмо 1 класса\": \"LETTER_CLASS_1\",\n  \"Посылка\": \"POSTAL_PARCEL\"\n};\nconst CATS  = { \"Заказное\": \"ORDERED\", \"Простое\": \"SIMPLE\",\n                \"С объявленной ценностью\": \"DECLARED\" };\nconst PAY   = { \"Знак онлайн оплаты\": \"ONLINE_PAYMENT_MARK\",\n                \"Безналичный расчет\": \"CASHLESS\" };\n\n// проверка обязательных полей - пусть узел говорит, чего не хватает\nconst need = [\"surname\", \"given_name\", \"index_to\", \"place_to\", \"street_to\", \"house_to\", \"mass\"];\nfor (const k of need) {\n  if (!d[k]) throw new Error(\"Нет поля \" + k + \". Пришло: \" + JSON.stringify(d));\n}\n\nconst order = {\n  \"address-type-to\": \"DEFAULT\",\n  \"surname\": d.surname,\n  \"given-name\": d.given_name,\n  \"middle-name\": d.middle_name || \"\",\n  \"index-to\": Number(d.index_to),\n  \"region-to\": d.region_to || \"\",\n  \"place-to\": d.place_to,\n  \"street-to\": d.street_to,\n  \"house-to\": d.house_to,\n  \"mail-direct\": 643,\n  \"mail-type\": TYPES[d.mail_type] || \"BANDEROL\",\n  \"mail-category\": CATS[d.mail_category] || \"ORDERED\",\n  \"mass\": Number(d.mass),\n  \"order-num\": String(d.lead_id),\n  \"payment-method\": PAY[d.payment] || \"CASHLESS\",\n  \"transport-type\": \"SURFACE\",\n  \"postoffice-code\": String(d.postoffice_code || \"191036\")\n};\n\nreturn [order];   // массив без обёртки - как в рабочем примере!"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "3bed0fa6-deef-45be-97df-7ae100bc41ba",
      "name": "собрать заказ"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "https://otpravka-api.pochta.ru/2.0/user/backlog",
        "authentication": "genericCredentialType",
