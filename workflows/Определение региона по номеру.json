    },
    {
      "parameters": {
        "jsCode": "const contact = JSON.parse(items[0].json.data);\n\nconst phone = contact.custom_fields_values\n  ?.find(field => field.field_code === 'PHONE')\n  ?.values?.[0]?.value ?? null;\n\nreturn [\n  {\n    json: {\n      phone\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        416
      ],
      "id": "f44d017d-b69f-4403-8e9c-734b5979a817",
      "name": "Получаем номер"
    },
    {
      "parameters": {
        "jsCode": "const phone = $json.phone;\n\n// Оставляем только цифры\nconst digits = phone.replace(/\\D/g, '');\n\n// Убираем код страны 7/8\nconst national = digits.replace(/^[78]/, '');\n\nconst def = national.slice(0, 3);\nconst number = Number(national.slice(3));\n\nreturn [\n  {\n    json: {\n      phone,\n      def,\n      number\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        416
      ],
      "id": "abf57fb9-314a-4f45-81cb-98e4f039e7b1",
      "name": "Обработка формата",
      "onError": "continueErrorOutput"
    },
