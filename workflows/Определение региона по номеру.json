    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = JSON.parse(item.json.data);\n\n  const mainContact = lead._embedded?.contacts?.find(\n    contact => contact.is_main === true\n  );\n\n  return {\n    json: {\n      lead_id: lead.id,\n      contact_id: mainContact?.id ?? null\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        240
      ],
